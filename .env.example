# Required
NUGEN_API_KEY=your_api_key_here

# Original single-model /analyze endpoint
NUGEN_MODEL_ID=model_fhir-healthcare-reasoning_alignment_01m1tybce6bsr93
NUGEN_ENDPOINT=https://api.nugen.in/api/v3/inference/completions

# Multi-expert panel (/orchestrate). Expert ids come from scripts/provision_experts.py.
EXPERT_FHIR_MODEL_ID=model_fhir-healthcare-reasoning_alignment_01m1tybce6bsr93
EXPERT_CLINICAL_MODEL_ID=
EXPERT_PRIOR_AUTH_MODEL_ID=
ROUTER_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
SYNTH_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct

# Optional tuning
# NUGEN_BASE_URL=https://api.nugen.in
# NUGEN_PROMPT_TRUNCATE_LEN=4096
# EXPERT_TIMEOUT_SECONDS=90
# ROUTER_TIMEOUT_SECONDS=30
# LOW_CONFIDENCE_THRESHOLD=50
# FEEDBACK_PATH=data/feedback.jsonl
# ADMIN_TOKEN=change-me            # enables GET /feedback/export
# NUGEN_MOCK=1                     # offline mock responses, for tests/demo only
